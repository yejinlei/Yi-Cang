      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "yizang:phoneticNote",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "生僻字注音",
      "rdfs:domain": {
        "@id": "yizang:Continuant"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "yizang:semanticNote",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "语义差异说明",
      "rdfs:domain": {
        "@id": "yizang:Continuant"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "yizang:vernacular",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "白话翻译",
      "rdfs:domain": {
        "@id": "yizang:Continuant"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "yizang:collationNote",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "校勘记录",
      "rdfs:domain": {
        "@id": "yizang:Continuant"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "yizang:sourcePosition",
      "@type": "owl:DatatypeProperty",
